    given-names: "Firstname"
    orcid: "https://orcid.org/0000-0000-0000-0000"
title: "Long-Read RNA-seq Transcript Reconstruction and Quantification Workflow"
version: 1.0.0
date-released: 2026-07-30
url: "https://github.com/your-org/transcripts_workflow"
abstract: "A modular, reproducible Snakemake workflow for benchmarking long-read RNA-seq transcript reconstruction and quantification tools (kallisto, bambu, IsoQuant, IsoSeq, oarfish, FLAIR) with SIRV/ERCC spike-in controls and SQANTI3 quality assessment."
keywords:
  - "RNA-seq"
  - "long-reads"
  - "transcriptomics"
  - "PacBio"
  - "Oxford Nanopore"
  - "Snakemake"
  - "isoforms"
