# Snakemake + Conda artefacts
.snakemake/
__pycache__/
*.pyc
*.pyo

# Log and benchmark directories
logs/
benchmarks/
# Internal agent logs & temp plots
.agents/
*.pdf
*.png
config_*.yml
metadata_*.csv
factors_*.csv
workflow/test_data/chr1*

# Results directories
results/
results*/

# Externally cloned tools (auto-installed by workflow rules)
SQANTI3/
tama/

# Per-user config with absolute paths — do NOT commit real paths
# workflow/config/config.yml  # Commit only the template version

# R session history
*.Rhistory
.RData

# Common bioinformatics intermediate files
*.bam
*.bam.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sam

# Conda environment caches
.conda/
envs/.snakemake_conda_envs/

# Jupyter / IPython
.ipynb_checkpoints/

# OS generated files
.DS_Store
Thumbs.db

# HTML reports generated by Snakemake
*.html

# Data directories (large files should not be committed)
data/
